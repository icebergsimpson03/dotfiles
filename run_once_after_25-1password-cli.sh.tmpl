{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Installs the 1Password CLI from 1Password's apt repo.
set -euo pipefail

if dpkg -s 1password-cli >/dev/null 2>&1; then
  echo "1Password CLI already installed."
  exit 0
fi

arch="$(dpkg --print-architecture)"
key_url=https://downloads.1password.com/linux/keys/1password.asc
policy_dir=/etc/debsig/policies/AC2D62742012EA22
debsig_dir=/usr/share/debsig/keyrings/AC2D62742012EA22

curl -fsSL "$key_url" | sudo gpg --batch --yes --dearmor \
  --output /usr/share/keyrings/1password-archive-keyring.gpg

echo "deb [arch=$arch signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/$arch stable main" |
  sudo tee /etc/apt/sources.list.d/1password.list >/dev/null

sudo mkdir -p "$policy_dir" "$debsig_dir"
curl -fsSL https://downloads.1password.com/linux/debian/debsig/1password.pol |
  sudo tee "$policy_dir/1password.pol" >/dev/null
curl -fsSL "$key_url" | sudo gpg --batch --yes --dearmor \
  --output "$debsig_dir/debsig.gpg"

sudo apt-get update
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y 1password-cli
{{ end -}}
