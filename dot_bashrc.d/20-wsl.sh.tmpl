# WSL-only: the few Windows tools we want, since appendWindowsPath=false.

_winhome="/mnt/c/Users/{{ .windowsUser }}"

# VS Code's `code` launcher (user install, then system install).
for d in "$_winhome/AppData/Local/Programs/Microsoft VS Code/bin" \
         "/mnt/c/Program Files/Microsoft VS Code/bin"; do
  if [ -d "$d" ]; then PATH="$PATH:$d"; break; fi
done
unset d

alias explorer='/mnt/c/Windows/explorer.exe'
alias clip='/mnt/c/Windows/System32/clip.exe'
alias pwsh='/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe'
# Open a file or URL with its Windows default app.
open() { /mnt/c/Windows/explorer.exe "$(wslpath -w "${1:-.}" 2>/dev/null || echo "$1")"; }

export WINHOME="$_winhome"
unset _winhome
