# Login shells (macOS Terminal, ssh, `wsl` first launch) read this, not ~/.bashrc.
# Keep it thin: everything lives in ~/.bashrc.

# Homebrew lives in /opt/homebrew on Apple Silicon and /usr/local on Intel.
for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [ -x "$brew" ]; then
    eval "$("$brew" shellenv)"
    break
  fi
done
unset brew

[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"
